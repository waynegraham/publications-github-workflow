{
  "name": "publications-github",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "sync:zenodo": "node scripts/zenodoReports.cjs",
    "sync:podcasts": "node scripts/syncPodcasts.cjs",
    "sync:youtube": "node scripts/syncYoutube.cjs",
    "sync": "pnpm run sync:zenodo && pnpm run sync:podcasts && pnpm run sync:youtube",
    "start": "run-p start:*",
    "start:eleventy": "eleventy --serve",
    "start:postcss": "postcss src/styles/*.css --dir _site --watch",

---
title: Reports
layout: default.njk
pagination:
  data: collections.reports
  size: 10
  alias: pagedReports
  reverse: false
  addAllPagesToCollections: true
eleventyComputed:
  permalink: '{% if pagination.pageNumber == 0 %}reports/{% else %}reports/{{ pagination.pageNumber }}/{% endif %}index.html'
---

<h1 class="text-2xl font-bold mb-6">All Reports</h1>

<div class="filters flex flex-wrap gap-4 mb-8">
  <label class="flex flex-col text-sm">
    Year
    <select id="filter-year" class="border rounded px-2 py-1">
      <option value="all">All</option>
      {% for year in collections.reportYears %}
        <option value="{{ year }}">{{ year }}</option>
      {% endfor %}
    </select>
  </label>

  <label class="flex flex-col text-sm">
    Type
    <select id="filter-type" class="border rounded px-2 py-1">
      <option value="all">All</option>
      {% for type in collections.reportTypes %}
        <option value="{{ type }}">{{ type }}</option>
      {% endfor %}
    </select>
  </label>
</div>

<ul id="report-list" class="space-y-6">
  {% for report in pagedReports %}
    <li
      class="report-item border-b pb-4"
      data-year="{{ report.data.date | date('yyyy') }}"
      data-type="{{ report.data.resource_type }}"
    >
      <h2 class="text-lg font-semibold">
        <a href="{{ report.url }}" class="hover:underline">
          {{ report.data.title }}
        </a>
      </h2>
      <p class="text-sm text-gray-600 mb-2">
        {{ report.data.date | date("yyyy-MM-dd") }}
        {% if report.data.resource_type %} — {{ report.data.resource_type }}{% endif %}
      </p>

      {% if report.data.thumbnail %}
        <img
          src="{{ report.data.thumbnail }}"
          alt="Thumbnail for {{ report.data.title }}"
          class="max-w-xs rounded shadow mb-2"
        />
      {% endif %}

      {% if report.templateContent %}
        <div class="prose max-w-none">{{ report.templateContent | safe }}</div>
      {% endif %}
    </li>
  {% endfor %}
</ul>

<!-- Pagination links -->
{% if pagination.pages.length > 1 %}
  <nav class="pagination flex gap-2 mt-10 text-sm">
    {% if pagination.href.previous %}
      <a href="{{ pagination.href.previous }}" class="px-3 py-1 bg-gray-100 rounded hover:bg-gray-200">← Previous</a>
    {% endif %}

    {% for page in pagination.pages %}
      {% set activeClass = "" %}
      {% if pagination.pageNumber == loop.index0 %}
        {% set activeClass = "bg-blue-600 text-white" %}
      {% else %}
        {% set activeClass = "bg-gray-100 text-gray-800" %}
      {% endif %}
      <a
        href="{{ pagination.hrefs[loop.index0] }}"
        class="px-3 py-1 rounded hover:bg-gray-200 {{ activeClass }}"
      >
        {{ loop.index }}
      </a>
    {% endfor %}

    {% if pagination.href.next %}
      <a href="{{ pagination.href.next }}" class="px-3 py-1 bg-gray-100 rounded hover:bg-gray-200">Next →</a>
    {% endif %}
  </nav>
{% endif %}

<script>
  const yearFilter = document.getElementById('filter-year');
  const typeFilter = document.getElementById('filter-type');
  const reports = document.querySelectorAll('#report-list .report-item');

  function applyFilters() {
    const selectedYear = yearFilter.value;
    const selectedType = typeFilter.value;

    reports.forEach(item => {
      const year = item.dataset.year;
      const type = item.dataset.type;
      const matchesYear = selectedYear === 'all' || year === selectedYear;
      const matchesType = selectedType === 'all' || type === selectedType;
      item.style.display = (matchesYear && matchesType) ? '' : 'none';
    });
  }

  yearFilter.addEventListener('change', applyFilters);
  typeFilter.addEventListener('change', applyFilters);
</script>
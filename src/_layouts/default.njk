<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <title>{{ title or "Untitled" }}</title>
        <link rel="stylesheet" href="/style.css"/>
    </head>
    <body>

        <header>
            <h1><a href="/">{{ title or "My Site" }}</a></h1>
        </header>

        <main>
            {{ content | safe }}
        </main>

        <footer>
            <p>&copy; {{ "now" | date("yyyy") }}</p>
        </footer>
    </body>
</html>
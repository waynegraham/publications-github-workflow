<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <title>{{ title or "Untitled" }}</title>
        <link media="screen" rel="stylesheet" href="{{ '/site.css' }}"/>

    </head>
    <body class="font-sans leading-relaxed antialiased max-w-3xl mx-auto px-4 py-6">
        <nav class="mb-6 text-sm">
            <ul class="flex gap-4 text-blue-600">
                <li>
                    <a href="/" class="hover:underline">Home</a>
                </li>
                <li>
                    <a href="/reports" class="hover:underline">All Reports</a>
                </li>
                <li>
                    <a href="/podcasts/" class="hover:underline">Podcasts</a>
                </li>
                <li>
                    <a href="/videos/" class="hover:underline">Videos</a>
                </li>
            </ul>
        </nav>
        <header class="mb-8">
            <h1 class="text-3xl font-bold">{{ title or "Reports" }}</h1>
        </header>

        <main>
            {{ content | safe }}
        </main>

        <footer class="mt-12 pt-4 border-t text-sm text-gray-500">
      &copy; {{ "now" | date("yyyy") }} – Generated by Eleventy
    </footer>
    </body>
</html>
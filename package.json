    "@tailwindcss/postcss": "^4.1.11",
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.21",
    "clean-css": "^5.3.3",
    "cross-env": "^7.0.3",
    "cssnano": "^7.1.0",
    "eleventy-plugin-hubspot": "^1.3.5",
    "luxon": "^3.7.1",
    "npm-run-all": "^4.1.5",

---
layout: default
---
<article class="space-y-6">
  <header>
    <h2 class="text-2xl font-semibold">{{ title }}</h2>
    <p class="text-sm text-gray-600">
      {{ date | date("yyyy-MM-dd") }}
      {% if resource_type %} — {{ resource_type }}{% endif %}
    </p>

    {% if authors %}
      <p class="text-sm text-gray-700">
        <strong>Authors:</strong> {{ authors | join(", ") }}
      </p>
    {% endif %}

    {% if thumbnail %}
      <img
        src="{{ thumbnail }}"
        alt="Thumbnail for {{ title }}"
        class="mt-4 w-full max-w-md rounded shadow"
      />
    {% endif %}
  </header>

  {% if content %}
    <section class="prose max-w-none">
      {{ content | safe }}
    </section>
  {% endif %}

  <section class="text-sm text-gray-700 border-t pt-4 space-y-1">
    {% if doi %}
      <p><strong>DOI:</strong> <a href="https://doi.org/{{ doi }}" class="text-blue-600 hover:underline">{{ doi }}</a></p>
    {% endif %}

    {% if url %}
      <p><strong>Zenodo URL:</strong> <a href="{{ url }}" class="text-blue-600 hover:underline">{{ url }}</a></p>
    {% endif %}

    {% if files %}
      <p><strong>Download:</strong> <a href="{{ files }}" class="text-blue-600 hover:underline">Files</a></p>
    {% endif %}

    {% if stats %}
      <p><strong>Views:</strong> {{ stats.views | default(0) }}</p>
      <p><strong>Downloads:</strong> {{ stats.downloads | default(0) }}</p>
    {% endif %}
  </section>
</article>